{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SI OpenCode managed release manifest",
  "type": "object",
  "required": ["schema", "version", "files"],
  "properties": {
    "schema": { "type": "integer", "minimum": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes", "fpga"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "fpga": { "type": "boolean" },
          "installMethod": { "enum": ["directCopy", "npm"] },
          "npmPackage": { "type": "string" },
          "npmVersion": { "type": "string" },
          "npmRegistry": { "type": "string" },
          "npmPath": { "type": "string" },
          "fallbackToDirectCopy": { "type": "boolean" },
          "optional": { "type": "boolean" },
          "requiresAdmin": { "type": "boolean" },
          "directPath": { "type": "string" }
        }
      }
    }
  }
}
